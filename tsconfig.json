{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noImplicitAny": false
  },
  "include": [
    "functions/**/*.js",
    "public/js/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "public/js/vendor/**",
    "dist-demo/**",
    "node_modules/**"
  ]
}
